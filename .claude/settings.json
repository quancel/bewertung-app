{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/agent-team/scripts/log-agent-run.py\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Protokolliere Agent-Aufruf"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/agent-team/scripts/log-agent-run.py\" 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
